PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# La URI solo vive en el backend. Nunca usar variables VITE_ para esta credencial.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster.mongodb.net
MONGODB_DATABASE=community_sos_demo_v3
# Origen municipal que se ajustará al vértice más cercano de la red vial.
MUNICIPALIDAD_LONGITUDE=-70.6014167
MUNICIPALIDAD_LATITUDE=-33.3986516
# Red vial importada con osm2pgrouting. El ETA usa cost_s/reverse_cost_s.
POSTGRES_ROUTING_SCHEMA=vita_routing
OPERATIONAL_ROUTING_MARGIN_DEGREES=0.05
OPERATIONAL_ROUTING_MAX_SNAP_METERS=1500
DATA_BACKEND=mongo
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=geodb
POSTGRES_SCHEMA=vita
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SSL=false
# Resiliencia ante reinicios o cortes breves del PostgreSQL remoto.
POSTGRES_POOL_MAX=6
POSTGRES_CONNECTION_TIMEOUT_MS=2000
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_STATEMENT_TIMEOUT_MS=60000
POSTGRES_RECOVERY_ATTEMPTS=2
POSTGRES_RECOVERY_BASE_DELAY_MS=350
POSTGRES_CIRCUIT_OPEN_MS=5000
DASHBOARD_RESPONSE_CACHE_TTL_MS=30000
DASHBOARD_STALE_CACHE_MS=3600000
DASHBOARD_RESPONSE_CACHE_MAX_ENTRIES=100
OPERATIONAL_ROUTING_CACHE_TTL_MS=900000
OPERATIONAL_ROUTING_STALE_CACHE_MS=86400000
ANALYTICS_CUTOFF_DATE=2026-08-15T23:59:59.999Z

# ID de la municipalidad de Vitacura incluido en los datos simulados.
MUNICIPALIDAD_ID=64f000000000000000000132

# Protección inicial para el mapa. El DTO impone un máximo de 8000.
MAPA_LIMITE_PREDETERMINADO=5000
