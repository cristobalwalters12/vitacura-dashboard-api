{
  "name": "vitacura-dashboard-api",
  "private": true,
  "version": "1.0.0",
  "description": "API NestJS para el dashboard comunitario de Vitacura",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "mongo:import-scenario": "node scripts/import-scenario.mjs",
    "mongo:enrich-operational": "node scripts/enrich-operational-fields.mjs",
    "mongo:indexes": "node scripts/create-indexes.mjs",
    "mongo:setup-incoming-alerts": "node scripts/setup-incoming-alerts.mjs",
    "mongo:explain": "node scripts/explain-dashboard.mjs",
    "postgres:migrate": "node scripts/postgres/migrate.mjs",
    "postgres:migration-status": "node scripts/postgres/migration-status.mjs",
    "postgres:import-scenario": "node scripts/postgres/import-scenario.mjs",
    "postgres:verify-data": "node scripts/postgres/verify-data.mjs",
    "postgres:explain": "node scripts/postgres/explain.mjs",
    "postgres:verify-api-parity": "node scripts/postgres/verify-api-parity.mjs",
    "dashboard:verify": "node scripts/verify-analytics.mjs",
    "dashboard:benchmark": "node scripts/benchmark-dashboard-api.mjs",
    "test:resilience": "node scripts/test-postgres-resilience.mjs",
    "check": "npm run build && npm run test:resilience"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-fastify": "^11.1.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "mongoose": "^8.18.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.21.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
